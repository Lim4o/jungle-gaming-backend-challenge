PORT=3000
INSTANCE_ID=local-1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering
DATABASE_POOL_MAX=20
LOCK_TIMEOUT_MS=5000
LOG_LEVEL=info

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_CONCURRENCY=10
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SEC=30
SQS_WAIT_TIME_SEC=10
# true = a aplicação cria as filas ao subir (o init do LocalStack já cria no compose)
SQS_CREATE_QUEUES=false

OUTBOX_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
REFERENCE_INTERVAL_MS=1000
REFERENCE_BATCH_SIZE=50
REFERENCE_LEASE_MS=30000
REFERENCE_RETRY_BASE_MS=2000
REFERENCE_RETRY_MAX_DELAY_MS=600000
REFERENCE_RETRY_MAX_ATTEMPTS=12

SHUTDOWN_TIMEOUT_MS=20000

# Testes
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering_test
TEST_SQS_ENDPOINT=http://localhost:4566
