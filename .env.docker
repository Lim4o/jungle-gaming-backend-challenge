# Variáveis das instâncias app-1/app-2/app-3 dentro do docker compose.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@postgres:5432/wagering
DATABASE_POOL_MAX=20
LOCK_TIMEOUT_MS=5000
LOG_LEVEL=info

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_CREATE_QUEUES=false

SHUTDOWN_TIMEOUT_MS=20000
